# Copier ce fichier en ".env" puis remplacer les valeurs.
# Si le mot de passe contient des caracteres speciaux, les encoder en URL (# -> %23, @ -> %40, : -> %3A, / -> %2F).

# Base ZKBio (source, lecture seule)
SOURCE_DATABASE_URL="postgresql://zk_lecture:mot_de_passe@127.0.0.1:5442/biosecurity-boot"

# Base ocp_pointage (cible)
DATABASE_URL="postgresql://root:mot_de_passe@127.0.0.1:5442/ocp_pointage"

# Vue v_presence_jour (base ocp_pointage), lecture seule
BIOTIME_DATABASE_URL="postgresql://ocp_readonly:mot_de_passe@127.0.0.1:5442/ocp_pointage"

# Intervalle de synchronisation (minutes)
SYNC_INTERVAL_MIN=15

# Cle secrete JWT (aleatoire, 32 caracteres minimum). Generer avec :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Cookies de session
# - false : acces en HTTP sur le reseau local (PC, telephones)
# - true  : uniquement si le site est servi en HTTPS
SECURE_COOKIES=false
